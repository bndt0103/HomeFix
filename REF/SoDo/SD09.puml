@startuml
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam roundcorner 8
skinparam sequenceMessageAlign center
skinparam maxMessageSize 280
skinparam ParticipantBackgroundColor #EDF7F0
skinparam ParticipantBorderColor #348059
skinparam ArrowColor #345346
skinparam NoteBackgroundColor #FFF8E6
hide footbox
title SD09 — Lập phiếu nghiệm thu
actor "Kỹ thuật viên" as A
boundary "Giao diện React" as UI
control "API / quotes.js" as API
database "SQL Server" as DB
A -> UI : Nhập và xác nhận
UI -> API : POST /orders/:id/acceptances\ncause, solution, photoIds[], expectedVersion
activate API
API -> API : JWT, vai trò, Zod
API -> DB : BEGIN TRAN + sp_getapplock
DB --> API : Giữ khóa giao dịch
API -> DB : Đọc dữ liệu; kiểm tra điều kiện
DB --> API : Dữ liệu + rowversion
note over API,DB
Đang sửa; ảnh thuộc thợ và đơn
Không còn vật tư Pending
end note
alt Hợp lệ
API -> DB : INSERT PhieuNghiemThu từ giá đã duyệt\nGắn ảnh; sp_ChuyenTrangThaiDon
DB --> API : Kết quả cập nhật
API -> DB : COMMIT
API --> UI : 200/201 + dữ liệu + version mới
UI --> A : ChoNghiemThu; phiếu Pending
else Nhánh ngoại lệ
note over API,DB
Thiếu ảnh / chưa duyệt vật tư → 422/409
end note
API --> UI : Mã lỗi + thông báo
UI --> A : Giải thích và cho tải lại
end
deactivate API
@enduml
