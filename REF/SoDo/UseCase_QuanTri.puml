@startuml
left to right direction
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam shadowing false
skinparam usecaseBackgroundColor #EDF7F0
skinparam usecaseBorderColor #348059
actor "Khách hàng" as KH
actor "Kỹ thuật viên" as KTV
actor "Kế toán" as KT
actor "Chăm sóc KH" as CSKH
actor "Quản trị viên" as ADMIN
actor "Giám đốc" as GD
actor "Điều phối viên" as DPV
rectangle "HomeFix — Chức năng hỗ trợ và quản lý" {
 usecase "Gửi phiếu hỗ trợ / bảo hành" as TICKET
 usecase "Xử lý phiếu hỗ trợ" as SUPPORT
 usecase "Nạp / rút và xem ví" as WALLET
 usecase "Xét yêu cầu ví / đối soát" as FINANCE
 usecase "Tài khoản, dịch vụ, cấu hình" as CONFIG
 usecase "Đăng ký cộng tác" as APPLY
 usecase "Xét hồ sơ kỹ thuật viên" as REVIEW
 usecase "Báo cáo hoạt động" as REPORT
 usecase "Ghi chú điều phối" as NOTE
}
KH --> TICKET
KH --> APPLY
KTV --> WALLET
KT --> FINANCE
KT --> REPORT
SUPPORT <-- CSKH
CONFIG <-- ADMIN
REVIEW <-- ADMIN
REPORT <-- GD
NOTE <-- DPV
REPORT <-- DPV
@enduml
