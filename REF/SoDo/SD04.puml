@startuml
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam roundcorner 8
skinparam sequenceMessageAlign center
skinparam maxMessageSize 280
skinparam ParticipantBackgroundColor #EDF7F0
skinparam ParticipantBorderColor #348059
skinparam ArrowColor #345346
skinparam NoteBackgroundColor #FFF8E6
hide footbox
title SD04 — Phân công kỹ thuật viên
actor "Điều phối viên" as A
boundary "Giao diện React" as UI
control "API / orders.js" as API
database "SQL Server" as DB
A -> UI : Nhập và xác nhận
UI -> API : POST /orders/:id/assignments\ntechnicianId, expectedVersion
activate API
API -> API : JWT, vai trò, Zod
API -> DB : BEGIN TRAN + sp_getapplock
DB --> API : Giữ khóa giao dịch
API -> DB : Đọc dữ liệu; kiểm tra điều kiện
DB --> API : Dữ liệu + rowversion
note over API,DB
Đơn ChoPhanCong; thợ đúng nhóm, sẵn sàng
ví đủ tối thiểu và chưa giữ ca
end note
alt Hợp lệ
API -> DB : INSERT LenhDieuPhoi có expiresAt\nGắn thợ; sp_ChuyenTrangThaiDon
DB --> API : Kết quả cập nhật
API -> DB : COMMIT
API --> UI : 200/201 + dữ liệu + version mới
UI --> A : ChoNhan
else Nhánh ngoại lệ
note over API,DB
Thợ bị giao trước / không đủ điều kiện → 409
end note
API --> UI : Mã lỗi + thông báo
UI --> A : Giải thích và cho tải lại
end
deactivate API
@enduml
