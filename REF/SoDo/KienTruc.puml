@startuml
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam roundcorner 8
skinparam sequenceMessageAlign center
skinparam maxMessageSize 280
skinparam ParticipantBackgroundColor #EDF7F0
skinparam ParticipantBorderColor #348059
skinparam ArrowColor #345346
skinparam NoteBackgroundColor #FFF8E6
title Kiến trúc triển khai HomeFix
left to right direction
node "Trình duyệt máy tính" {
 [React / Vite] as WEB
}
node "Điện thoại Android" {
 [Capacitor + React] as APP
}
node "Máy chủ của nhóm (Windows)" {
 [Express REST API\nCổng 3000] as API
 [JWT + kiểm tra quyền\nXử lý nghiệp vụ / giao dịch] as BUS
 folder "Ảnh đính kèm riêng tư" as IMG
 database "SQL Server\nHomeFix_Final" as SQL
}
WEB --> API : HTTP trong LAN
APP --> API : HTTP trong LAN
API --> BUS
BUS --> SQL : mssql / ODBC\nWindows Authentication
BUS --> IMG : xác thực trước khi đọc
note bottom of SQL : 25 bảng • 3 stored procedures • 5 triggers\nKhông đưa tài khoản SQL vào website/APK.
@enduml
