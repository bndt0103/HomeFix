PORT=3000
DB_SERVER=localhost
DB_NAME=HomeFix_Final
DB_AUTH=windows
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server
DB_ENCRYPT=false
# Set DB_AUTH=sql and fill DB_USER/DB_PASSWORD only if your SQL Server uses SQL authentication.
DB_USER=
DB_PASSWORD=
JWT_SECRET=replace-with-a-random-value-at-least-32-characters
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000,https://localhost,http://localhost

# OTP email: Gmail SMTP requires no custom domain.
OTP_EMAIL_PROVIDER=gmail
GMAIL_USER=
# Google App Password (16 characters), NOT your normal Google password.
GMAIL_APP_PASSWORD=

# Optional: set OTP_EMAIL_PROVIDER=resend to use the previous provider.
RESEND_API_KEY=
OTP_EMAIL_FROM=
