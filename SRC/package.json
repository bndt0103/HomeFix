{
  "name": "homefix-final",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "node backend/src/server.js",
    "online:setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-tunnel.ps1",
    "online": "node scripts/start-online.js",
    "online:status": "node scripts/start-online.js --status",
    "online:check-db": "node scripts/check-online-db.js",
    "online:stop": "node scripts/start-online.js --stop",
    "db:init": "node scripts/init-db.js",
    "mobile:sync": "npm run mobile:sync -w frontend",
    "db:migrate:otp": "node scripts/migrate-otp.js",
    "db:migrate:payments": "node scripts/migrate-payments.js",
    "email:check": "node scripts/check-email.js",
    "db:migrate:services": "node scripts/migrate-services.js",
    "db:migrate:avatar": "node scripts/migrate-avatar.js",
    "db:migrate:account-locks": "node scripts/migrate-account-locks.js",
    "db:migrate:policies": "node scripts/migrate-policy-proposals.js",
    "db:migrate": "npm run db:migrate:otp && npm run db:migrate:payments && npm run db:migrate:services && npm run db:migrate:avatar && npm run db:migrate:account-locks && npm run db:migrate:technician-ui && npm run db:migrate:policies && npm run db:migrate:customer-location && npm run db:migrate:dispatch && npm run db:migrate:materials && npm run db:migrate:order-items && npm run db:migrate:support-chat",
    "db:migrate:customer-location": "node scripts/migrate-customer-location.js",
    "db:migrate:technician-ui": "node scripts/migrate-technician-ui.js",
    "db:migrate:dispatch": "node scripts/migrate-dispatch.js",
    "db:migrate:materials": "node scripts/migrate-materials.js",
    "db:migrate:order-items": "node scripts/migrate-order-items.js",
    "db:migrate:support-chat": "node scripts/migrate-support-chat.js",
    "format": "prettier --write \"backend/src/**/*.js\" \"frontend/src/**/*.{js,jsx,css}\" \"scripts/*.js\" \"database/*.js\" \"manual/*.js\" \"manual/*.css\" \"package.json\" \"backend/package.json\" \"frontend/package.json\" \"frontend/capacitor.config.json\" \"frontend/vite.config.js\"",
    "format:check": "prettier --check \"backend/src/**/*.js\" \"frontend/src/**/*.{js,jsx,css}\" \"scripts/*.js\" \"database/*.js\" \"manual/*.js\" \"manual/*.css\" \"package.json\" \"backend/package.json\" \"frontend/package.json\" \"frontend/capacitor.config.json\" \"frontend/vite.config.js\""
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "3.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "msnodesqlv8@5.5.0": true,
    "sharp@0.34.5": true
  }
}
