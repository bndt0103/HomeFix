{
  "name": "homefix-final",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "node backend/src/server.js",
    "online:setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-tunnel.ps1",
    "online": "node scripts/start-online.js",
    "online:status": "node scripts/start-online.js --status",
    "online:check-db": "node scripts/check-online-db.js",
    "online:stop": "node scripts/start-online.js --stop",
    "db:init": "node scripts/init-db.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:e2e": "node tests/ui-smoke.mjs && node tests/ui-workflow.mjs",
    "mobile:sync": "npm run mobile:sync -w frontend",
    "db:migrate:otp": "node scripts/migrate-otp.js",
    "db:migrate:payments": "node scripts/migrate-payments.js",
    "test:otp": "node --test --test-concurrency=1 tests/otp-delivery.test.js tests/otp-integration.test.js",
    "test:otp:ui": "npm run build && node tests/ui-otp.mjs",
    "email:check": "node scripts/check-email.js",
    "test:mobile": "node --test tests/mobile-api.test.js",
    "db:migrate:services": "node scripts/migrate-services.js",
    "db:migrate:avatar": "node scripts/migrate-avatar.js",
    "db:migrate:account-locks": "node scripts/migrate-account-locks.js",
    "db:migrate:policies": "node scripts/migrate-policy-proposals.js",
    "db:migrate": "npm run db:migrate:otp && npm run db:migrate:payments && npm run db:migrate:services && npm run db:migrate:avatar && npm run db:migrate:account-locks && npm run db:migrate:technician-ui && npm run db:migrate:policies && npm run db:migrate:customer-location",
    "db:migrate:customer-location": "node scripts/migrate-customer-location.js",
    "db:migrate:technician-ui": "node scripts/migrate-technician-ui.js",
    "test:customer-location": "node --test tests/customer-location.test.js",
    "test:attention": "node tests/ui-attention.mjs && node tests/ui-attention-flow.mjs",
    "test:director": "node --test tests/director-reports.test.js",
    "test:director:ui": "node tests/ui-director.mjs",
    "test:screen-tv": "node --test tests/screen-tv.test.js",
    "test:screen-tv:ui": "node tests/ui-screen-tv.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "playwright": "^1.55.1"
  }
}
